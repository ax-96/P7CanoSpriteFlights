<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label text="   Score: 0" name="ScoreLabel" style="align-self: center; font-size: 27px; color: rgb(229, 229, 229); height: 55px; top: 34px; border-top-width: 5px; border-left-color: rgb(240, 255, 255); border-right-color: rgb(240, 255, 255); border-top-color: rgb(240, 255, 255); border-bottom-color: rgb(240, 255, 255); border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; width: 191px; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; -unity-text-align: upper-center;"/>
    <ui:Button text="Restart" name="RestartButton" style="position: absolute; top: 50%; align-self: center; font-size: 20px; -unity-font-style: bold;"/>
</ui:UXML>
